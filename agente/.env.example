EVOLUTION_KEY=
EVOLUTION_INSTANCE=7146

# Aponte o webhook da instância para https://SEU-AGENTE/webhook,
# com o evento MESSAGES_UPSERT.

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
